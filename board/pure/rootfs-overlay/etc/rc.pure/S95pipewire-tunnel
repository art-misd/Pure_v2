#!/bin/sh

PIPEWIRE_BIN="/usr/bin/pipewire"
TUNNEL_IP="192.168.1.116"  # IP источника

start() {
    printf "Starting PipeWire Tunnel: "

    # Создаем конфигурацию
    mkdir -p /etc/pipewire/pipewire.conf.d
    cat > /etc/pipewire/pipewire.conf.d/50-tunnel.conf <<EOF
context.modules = [
    {   name = libpipewire-module-tunnel-sink
        args = {
            tunnel.remote = "tcp:$TUNNEL_IP"
            node.name = "remote_audio"
            node.description = "Remote Audio"
        }
    }
]
context.properties = {
    default.audio.sink = "remote_audio"
}
EOF

    # Запускаем PipeWire
    $PIPEWIRE_BIN > /dev/null 2>&1 &

    # Ждем инициализации
    sleep 1

    # Для ALSA-совместимости
    if [ -x "/usr/bin/pw-jack" ]; then
        pw-jack /usr/bin/alsa-sink > /dev/null 2>&1 &
    fi

    echo "OK"
}

stop() {
    printf "Stopping PipeWire: "
    killall -9 pipewire alsa-sink 2>/dev/null
    rm -f /etc/pipewire/pipewire.conf.d/50-tunnel.conf
    echo "OK"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit 0
